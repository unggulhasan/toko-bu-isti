# This dev default is a relative database alias, resolved by the Firebird
# server's own working directory -- fine for local dev, but production should
# point at an absolute path instead, e.g. (Windows, the production target):
#   firebird+firebird://SYSDBA:masterkey@localhost:3050/C:/toko-bu-isti/backend/toko.fdb
# or (macOS/Linux dev, an absolute Unix path):
#   firebird+firebird://SYSDBA:masterkey@localhost:3050//Users/you/toko-bu-isti/backend/toko.fdb
# SQLAlchemy's URL parser strips one leading slash after the port, so a single
# slash there parses as a relative name, not a path -- an absolute Unix path
# already starts with a slash (so it needs //), but a Windows drive letter
# does not (so it needs only /); doubling it there leaves a stray leading
# slash before the drive letter ("/C:/...") that the Firebird client can't
# resolve, and every connection attempt fails with "unavailable database".
DATABASE_URL=firebird+firebird://SYSDBA:masterkey@localhost:3050/tokobuisti

# Next.js and FastAPI run on the same machine (the server PC) -- the client PC's
# browser never talks to FastAPI directly, only to Next.js, which proxies /api/*
# server-side (see frontend/next.config.ts). So this is always a same-machine
# origin, in dev and production alike.
CORS_ORIGINS=http://localhost:3000

# Always 127.0.0.1: only the co-located Next.js process calls this, never a
# browser, so there's no reason to bind beyond loopback even in production.
API_HOST=127.0.0.1
API_PORT=8000

# Windows only, if fbclient.dll is off PATH:
# FB_CLIENT_LIBRARY=

# Printer: "network" targets escpresso for dev; the real TM-U220D is USB, so
# production sets PRINTER_BACKEND=usb. The vendor/product ids are usually not
# needed -- printer.py auto-detects the USB Printer Class device. Only set these
# if the server has more than one USB printer attached, or auto-detect fails:
PRINTER_BACKEND=network
PRINTER_HOST=127.0.0.1
PRINTER_PORT=9100
# PRINTER_USB_VENDOR_ID=04b8
# PRINTER_USB_PRODUCT_ID=0202

DATABASE_URL=firebird+firebird://SYSDBA:masterkey@localhost:3050/tokobuisti
CORS_ORIGINS=http://localhost:3000,http://192.168.1.10:3000

# 127.0.0.1 for dev. Production binds 0.0.0.0 so the shop's LAN clients can
# reach it -- the Windows box has no internet exposure, so this is fine.
API_HOST=127.0.0.1
API_PORT=8000

# Windows only, if fbclient.dll is off PATH:
# FB_CLIENT_LIBRARY=

# Printer: "network" targets escpresso for dev; the real TM-U220D is USB, so
# production sets PRINTER_BACKEND=usb. The vendor/product ids are usually not
# needed -- printer.py auto-detects the USB Printer Class device. Only set these
# if the server has more than one USB printer attached, or auto-detect fails:
PRINTER_BACKEND=network
PRINTER_HOST=127.0.0.1
PRINTER_PORT=9100
# PRINTER_USB_VENDOR_ID=04b8
# PRINTER_USB_PRODUCT_ID=0202

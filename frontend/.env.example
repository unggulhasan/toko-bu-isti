# Origin of the FastAPI backend. Server-side only -- consumed by next.config.ts
# to build the /api/* rewrite. Never exposed to the browser.
#
# Read once at server start: changing this needs a `next build`/`next start`
# restart, not just an edit to this file.
#
# Always 127.0.0.1, in dev and production alike: Next.js and FastAPI run
# side-by-side on the same machine (the server PC). The client PC has no local
# checkout and no Node install -- it's just a browser pointed at the server PC's
# LAN IP on port 3000; Next.js does the rest server-side.
API_ORIGIN=http://127.0.0.1:8000

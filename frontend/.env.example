# Origin of the FastAPI backend. Server-side only -- consumed by next.config.ts
# to build the /api/* rewrite. Never exposed to the browser.
#
# Read once at server start: changing this needs a `next build`/`next start`
# restart, not just an edit to this file.
#
# Dev (backend on the same machine):
API_ORIGIN=http://127.0.0.1:8000
#
# Production: point at the shop's server machine's LAN IP (not 127.0.0.1) --
# the backend's API_HOST can just be 0.0.0.0 since there's no internet exposure:
# API_ORIGIN=http://192.168.1.10:8000
